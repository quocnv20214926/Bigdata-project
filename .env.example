# Copy this file to .env and fill in the secrets. .env is gitignored; never commit it.
# Load into PowerShell:   . .\scripts\load-env.ps1
# Docker Compose:         docker compose --env-file .env -f infra/compose.base.yml -f infra/compose.stream.yml up -d

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAXMEMORY=2gb

# ---- Kafka ----
# From the host use localhost:9092; containers use kafka:29092 (set in compose.stream.yml).
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_EVENTS=events
KAFKA_PARTITIONS=6

# ---- MinIO / S3 ----
# MinIO runs only with --profile lake (Pair 1). minio/minio was removed from Docker Hub (Sep 2026).
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
RAW_PATH=s3a://lake/raw/
CLEAN_PATH=s3a://lake/clean/events/

# ---- Streaming job ----
STARTING_OFFSETS=earliest
MAX_OFFSETS_PER_TRIGGER=50000
TRIGGER_SECONDS=2
WATERMARK=10 minutes

# ---- API ----
API_MODE=mock
