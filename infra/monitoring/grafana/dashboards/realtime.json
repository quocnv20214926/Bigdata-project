{
  "uid": "pair2-realtime",
  "title": "Recommender: real-time pipeline and API",
  "tags": [
    "recommender",
    "pair2"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
